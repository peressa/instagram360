{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instagram360",
  "compatibility_date": "2026-11-13",
  "main": "worker/main.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/p/*"
    ]
  },
  "routes": [
    {
      "pattern": "ig360.peressa.dev",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARED_PROJECTS",
        "class_name": "SharedProject"
      },
      {
        "name": "PROJECTS",
        "class_name": "ProjectRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "shared-projects-v1",
      "new_sqlite_classes": [
        "SharedProject"
      ]
    },
    {
      "tag": "public-projects-v1",
      "new_sqlite_classes": [
        "ProjectRoom"
      ]
    }
  ]
}
